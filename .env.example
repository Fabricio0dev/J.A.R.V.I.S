# Google Identity Services — use the same public Web Client ID in both variables.
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID

# Generate with: openssl rand -base64 48. Server-only; never use a VITE_ prefix.
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Exact production origin, e.g. https://your-app.vercel.app
APP_ORIGIN=https://YOUR_VERCEL_DOMAIN